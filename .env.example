# ETERNA backend URL
ETERNA_API_URL=http://localhost:8080

# Portalens service-konto — ETERNA-användaren som anonyma besökare söker som.
# Obligatoriskt: utan dessa failar varje sökning med EnvInvalidVariables.
# Ingen tyst fallback till gäst-åtkomst sker.
#
# Kontot avgör vad en besökare utan inloggning kan se. Ge det minsta möjliga
# roller i ETERNA (Administration → Användare och grupper):
#   aip.read, descriptive_metadata.read, representation.read
#
# Använd ALDRIG ett administratörskonto: varje anonym besökare får kontots
# läsrättigheter via portalens sökvägar.
PORTAL_SERVICE_USER=portal-reader
PORTAL_SERVICE_PASSWORD=changeme
